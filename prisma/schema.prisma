// AI Project Optimizer data model.
// Phase 6 records a task execution. The model reply is stored.
// API keys are not stored. GitHub access tokens remain ciphertext only.
// Execution does not run shell commands or modify a repository.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

enum PullRequestStatus {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

enum BudgetPeriod {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  PROJECT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SYSTEM
}

enum OptimizationMode {
  SAVINGS
  BALANCED
  QUALITY
}

enum TaskType {
  ANALYSIS
  PLANNING
  ARCHITECTURE
  CODING
  REFACTORING
  DEBUGGING
  TESTING
  DOCUMENTATION
  SECURITY
  REVIEW
}

enum TaskDifficulty {
  LOW
  MEDIUM
  HIGH
}

enum ExecutionState {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  ESCALATED
  CANCELLED
}

enum ExecutionRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects              Project[]
  auditLogs             AuditLog[]
  githubAccount         GithubAccount?
  connectedRepositories ConnectedRepository[]
  providerPreferences   ProviderPreference[]
  projectPlans          ProjectPlan[]

  @@index([createdAt])
}

model Project {
  id               String           @id @default(cuid())
  userId           String
  name             String
  slug             String
  description      String?
  objective        String?          @db.Text
  status           ProjectStatus    @default(DRAFT)
  optimizationMode OptimizationMode @default(BALANCED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories Repository[]
  plans        ProjectPlan[]
  tasks        Task[]
  budgets      Budget[]
  pullRequests PullRequest[]
  costRecords   CostRecord[]
  auditLogs     AuditLog[]
  executionRuns ExecutionRun[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([createdAt])
}

model Repository {
  id                    String   @id @default(cuid())
  projectId             String
  name                  String
  url                   String?
  defaultBranch         String   @default("main")
  ownerLogin            String?
  githubRepoId          String?
  private               Boolean  @default(false)
  permissions           Json?
  connectedRepositoryId String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedRepository ConnectedRepository? @relation(fields: [connectedRepositoryId], references: [id], onDelete: SetNull)
  pullRequests        PullRequest[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([githubRepoId])
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models Model[]

  @@index([enabled])
}

model Model {
  id                    String   @id @default(cuid())
  providerId            String
  name                  String
  slug                  String
  contextWindow         Int?
  inputPricePerMillion  Decimal? @db.Decimal(12, 6)
  outputPricePerMillion Decimal? @db.Decimal(12, 6)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  provider    Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  decisions   ModelDecision[]
  attempts    TaskAttempt[]
  executions  TaskExecution[]
  tokenUsages TokenUsage[]
  costRecords CostRecord[]

  @@unique([providerId, slug])
  @@index([providerId])
  @@index([enabled])
}

model ProjectPlan {
  id               String           @id @default(cuid())
  projectId        String
  userId           String?
  goal             String           @db.Text
  optimizationMode OptimizationMode
  summary          String           @db.Text
  contextRequests  Json
  createdAt        DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([projectId, createdAt])
  @@index([userId])
}

model Task {
  id                     String         @id @default(cuid())
  projectId              String
  planId                 String?
  planKey                String?
  title                  String
  description            String?        @db.Text
  status                 TaskStatus     @default(PENDING)
  priority               TaskPriority   @default(MEDIUM)
  type                   TaskType       @default(ANALYSIS)
  difficulty             TaskDifficulty @default(MEDIUM)
  complexity             Int            @default(1)
  expectedOutput         String         @default("") @db.Text
  verificationCriteria   String         @default("") @db.Text
  sequence               Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan          ProjectPlan?     @relation(fields: [planId], references: [id], onDelete: Cascade)
  dependencies  TaskDependency[] @relation("DependencySource")
  dependents    TaskDependency[] @relation("DependencyTarget")
  attempts      TaskAttempt[]
  decisions     ModelDecision[]
  verifications Verification[]
  executions    TaskExecution[]

  @@unique([planId, planKey])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([planId, sequence])
  @@index([createdAt])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task      Task @relation("DependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model TaskAttempt {
  id           String        @id @default(cuid())
  taskId       String
  modelId      String?
  status       AttemptStatus @default(QUEUED)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model         Model?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  verifications Verification[]
  tokenUsages   TokenUsage[]
  costRecords   CostRecord[]

  @@index([taskId, status])
  @@index([modelId])
  @@index([createdAt])
}

model ExecutionRun {
  id              String             @id @default(cuid())
  projectId       String
  status          ExecutionRunStatus @default(RUNNING)
  cancelRequested Boolean            @default(false)
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TaskExecution[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TaskExecution {
  id               String         @id @default(cuid())
  taskId           String
  runId            String?
  state            ExecutionState
  attemptCount     Int            @default(0)
  provider         String?
  modelSlug        String?
  modelId          String?
  result           String?        @db.Text
  errorMessage     String?        @db.Text
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  durationMs       Int            @default(0)
  estimatedCost    Decimal?       @db.Decimal(14, 6)
  actualCost       Decimal?       @db.Decimal(14, 6)
  escalated        Boolean        @default(false)
  ignoredCommand   Boolean        @default(false)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime       @default(now())

  task  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run   ExecutionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  model Model?        @relation(fields: [modelId], references: [id], onDelete: SetNull)
  logs  ExecutionLog[]

  @@index([taskId, createdAt])
  @@index([modelId])
  @@index([runId])
}

model ExecutionLog {
  id          String         @id @default(cuid())
  executionId String
  taskId      String
  state       ExecutionState
  attempt     Int            @default(0)
  message     String         @db.Text
  createdAt   DateTime       @default(now())

  execution TaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([taskId, createdAt])
}

model ModelDecision {
  id                   String            @id @default(cuid())
  taskId               String
  modelId              String?
  provider             String?
  modelSlug            String?
  optimizationMode     OptimizationMode  @default(BALANCED)
  estimatedCost        Decimal?          @db.Decimal(14, 6)
  successProbability   Decimal?          @db.Decimal(5, 4)
  outcome              String            @default("selected")
  reason               String            @db.Text
  factors              Json              @default("[]")
  candidates           Json              @default("[]")
  createdAt            DateTime          @default(now())

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model Model? @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([modelId])
}

model Verification {
  id            String             @id @default(cuid())
  taskId        String
  taskAttemptId String?
  status        VerificationStatus @default(PENDING)
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt TaskAttempt? @relation(fields: [taskAttemptId], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([taskAttemptId])
}

model TokenUsage {
  id            String   @id @default(cuid())
  taskAttemptId String
  modelId       String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())

  attempt TaskAttempt @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)
  model   Model       @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([taskAttemptId])
  @@index([modelId, createdAt])
}

model CostRecord {
  id            String   @id @default(cuid())
  projectId     String
  taskAttemptId String?
  modelId       String?
  amount        Decimal  @db.Decimal(14, 6)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempt TaskAttempt? @relation(fields: [taskAttemptId], references: [id], onDelete: SetNull)
  model   Model?       @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([modelId])
  @@index([currency])
}

model Budget {
  id          String       @id @default(cuid())
  projectId   String
  limitAmount Decimal      @db.Decimal(14, 6)
  currency    String       @default("USD")
  period      BudgetPeriod @default(PROJECT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, period])
}

model PullRequest {
  id             String            @id @default(cuid())
  projectId      String
  repositoryId   String?
  title          String
  url            String?
  externalNumber Int?
  status         PullRequestStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([repositoryId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  projectId  String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model GithubAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  githubUserId    String   @unique
  login           String
  accountType     String
  avatarUrl       String?
  installationId  String?
  scopes          String
  tokenCiphertext String   @db.Text
  tokenIv         String
  tokenTag        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories ConnectedRepository[]

  @@index([login])
}

model ConnectedRepository {
  id             String   @id @default(cuid())
  userId         String
  githubAccountId String
  githubRepoId   String
  ownerLogin     String
  name           String
  fullName       String
  defaultBranch  String
  htmlUrl        String
  private        Boolean
  description    String?
  permissions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    GithubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  repository Repository?

  @@unique([userId, githubRepoId])
  @@index([githubAccountId])
  @@index([userId, fullName])
}

model ProviderPreference {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
