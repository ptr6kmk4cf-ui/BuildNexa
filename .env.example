# Local PostgreSQL. Copy this file to .env and adjust if your database differs.
# The app boots without DATABASE_URL. Lists stay empty until Postgres is reachable
# and the Prisma migration has been applied.
#
# Start the database with: docker compose up -d
# Then apply the schema with: npx prisma migrate dev
#
# Production does not read projects until a GitHub session exists. Leave GitHub
# unset only for local mode. Never put a secret in a NEXT_PUBLIC_ variable.
# See DEPLOYMENT.md and SECURITY.md.

DATABASE_URL="postgresql://optimizer:optimizer@127.0.0.1:5432/ai_project_optimizer"

# debug | info | warn | error
LOG_LEVEL="info"

# GitHub OAuth is optional. Leave these unset to boot without a GitHub app.
# Callback URL registered on the OAuth app must match GITHUB_CALLBACK_URL.
# APP_SECRET signs the OAuth state and session cookies (at least 32 characters).
# TOKEN_ENCRYPTION_KEY is 32 bytes, base64-encoded, and encrypts the access token at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_CALLBACK_URL="http://127.0.0.1:43123/api/github/callback"
# APP_SECRET=""
# TOKEN_ENCRYPTION_KEY=""

# Model provider keys are optional and server-only. Leave a key unset to keep that
# provider from being called. Do not put these values in NEXT_PUBLIC_ variables.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
#
# Per-million USD prices, keyed by provider:modelId from the registry.
# Replace 0.00 with the rate on your provider contract. Omitted models stay unpriced.
# MODEL_PRICING='{"openai:gpt-4.1":{"inputPerMillion":"0.00","outputPerMillion":"0.00","cachedInputPerMillion":"0.00"}}'

# Parent cgroup for repository sandboxes. Commands are refused when this is missing.
# SANDBOX_CGROUP_PARENT="/sys/fs/cgroup/apo"

# Production
# NODE_ENV=production is set by the host. With it set, project reads and writes
# require a GitHub session. APP_SECRET, TOKEN_ENCRYPTION_KEY, and both GitHub
# client values are required before Connect GitHub works. Use an https callback
# URL that matches the OAuth app. DATABASE_URL must point at the production
# database. Apply migrations with: npx prisma migrate deploy
