{
  "name": "ai-project-optimizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && next dev --port 43123",
    "build": "npm run db:generate && next build",
    "start": "next start --port 43123",
    "lint": "eslint .",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "npm run db:generate && vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
